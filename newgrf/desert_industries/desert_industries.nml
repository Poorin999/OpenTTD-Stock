/* Desert Industries: generated by make_desert_industries.py, do not edit by hand. */
grf {
    grfid: "SDI\01";
    name: string(STR_GRF_NAME);
    desc: string(STR_GRF_DESCRIPTION);
    version: 1;
    min_compatible_version: 1;
}

/* The cargos are added to Sub-tropical by the mod (src/firs_desert_cargo.cpp); FOOD and GOOD are default cargos. */
cargotable {
    SGCN, NUTS, COTN, SUGR, EOIL, FOOD, GOOD
}

spriteset (ss_all, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/sheet.png") {
    [   0,   1, 64, 31, -31,   0]   // 0 G_CANE_A
    [  68,   1, 64, 31, -31,   0]   // 1 G_CANE_B
    [ 136,   1, 64, 31, -31,   0]   // 2 G_DIRT
    [ 204,   1, 64, 31, -31,   0]   // 3 G_COTTON
    [ 272,   1, 64, 31, -31,   0]   // 4 G_CONC
    [ 340,   1, 64, 31, -31,   0]   // 5 G_GROVE
    [ 408,  36, 64, 75, -31, -44]   // 6 B_FARM
    [ 476,  36, 64, 75, -31, -44]   // 7 B_TREES
    [ 544,  36, 64, 75, -31, -44]   // 8 B_MILL
    [ 612,  36, 64, 75, -31, -44]   // 9 B_SILOS
    [ 680,  36, 64, 75, -31, -44]   // 10 B_PRESS
    [ 748,  36, 64, 75, -31, -44]   // 11 B_TEXTILE_A
    [ 816,  36, 64, 75, -31, -44]   // 12 B_TEXTILE_B
    [ 884,  36, 64, 75, -31, -44]   // 13 B_BAKERY
    [ 952,  36, 64, 75, -31, -44]   // 14 B_YARD
}

spritelayout lt_tile_cane_a {
    ground { sprite: ss_all(0); }
}
item(FEAT_INDUSTRYTILES, tile_cane_a) {
    property {
        substitute: 0;   // the tile that supplies the defaults; the flag below makes the tile accept what the industry accepts
        special_flags: bitmask(INDTILE_FLAG_ACCEPT_ALL);
    }
    graphics {
        lt_tile_cane_a;
    }
}

