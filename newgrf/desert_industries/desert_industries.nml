item(FEAT_INDUSTRIES, ind_sugar_plantation) {
    property {
        substitute: INDUSTRYTYPE_FRUIT_PLANTATION;
        name: string(STR_NAME_SUGAR_PLANTATION);
        layouts: [lay_sugar_plantation];
        life_type: IND_LIFE_TYPE_ORGANIC;
        cargo_types: [
            produce_cargo("SGCN", 9)
        ];
        map_colour: 0x6C;
        prob_map_gen: 5;
        prob_in_game: 4;
        fund_cost_multiplier: 55;
        spec_flags: 0;
        new_ind_msg: string(STR_NEW_SUGAR_PLANTATION);
        closure_msg: string(STR_CLOSE_SUGAR_PLANTATION);
        prod_increase_msg: string(STR_UP_SUGAR_PLANTATION);
        prod_decrease_msg: string(STR_DOWN_SUGAR_PLANTATION);
    }
}

