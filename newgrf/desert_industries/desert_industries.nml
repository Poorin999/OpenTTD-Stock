tilelayout lay_sugar_plantation {
    0, 0: tile_cane_a;
    1, 0: tile_cane_b;
    0, 1: tile_farm;
    1, 1: tile_cane_a;
}
tilelayout lay_nut_grove {
    0, 0: tile_grove;
    1, 0: tile_grove;
    0, 1: tile_farm;
    1, 1: tile_grove;
}
tilelayout lay_cotton_plantation {
    0, 0: tile_cotton;
    1, 0: tile_cotton;
    0, 1: tile_farm;
    1, 1: tile_cotton;
}
tilelayout lay_sugar_mill {
    0, 0: tile_mill;
    1, 0: tile_silos;
    0, 1: tile_yard;
    1, 1: tile_mill;
}
tilelayout lay_oil_press {
    0, 0: tile_press;
    1, 0: tile_yard;
}
tilelayout lay_textile_mill {
    0, 0: tile_textile_a;
    1, 0: tile_textile_a;
    0, 1: tile_yard;
    1, 1: tile_textile_b;
}
tilelayout lay_bakery {
    0, 0: tile_bakery;
    1, 0: tile_yard;
}

item(FEAT_INDUSTRIES, ind_sugar_plantation) {
    property {
        substitute: INDUSTRYTYPE_FRUIT_PLANTATION;
        name: string(STR_NAME_SUGAR_PLANTATION);
        layouts: [lay_sugar_plantation];
        life_type: IND_LIFE_TYPE_ORGANIC;
        cargo_types: [
            produce_cargo("SGCN", 9)
        ];
        map_colour: 0x6C;
        prob_map_gen: 5;
        prob_in_game: 4;
        fund_cost_multiplier: 55;
        spec_flags: 0;
        new_ind_msg: string(STR_NEW_SUGAR_PLANTATION);
        closure_msg: string(STR_CLOSE_SUGAR_PLANTATION);
        prod_increase_msg: string(STR_UP_SUGAR_PLANTATION);
        prod_decrease_msg: string(STR_DOWN_SUGAR_PLANTATION);
    }
}

