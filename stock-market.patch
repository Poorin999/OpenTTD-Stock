+			case WID_S_STOCK: {
+				/* Draw a tiny candlestick chart as icon. */
+				const int ox = r.left + ScaleGUITrad(4);
+				const int oy = r.top + ScaleGUITrad(1);
+				struct MiniCandle { int x, wick_top, wick_bottom, body_top, body_bottom; bool up; };
+				static constexpr MiniCandle candles[] = {
+					{ 2, 3, 10, 5, 8, true},
+					{ 9, 1,  8, 2, 5, true},
+					{16, 4, 10, 6, 9, false},
+				};
+				for (const MiniCandle &c : candles) {
+					const int cx = ox + ScaleGUITrad(c.x);
+					GfxDrawLine(cx, oy + ScaleGUITrad(c.wick_top), cx, oy + ScaleGUITrad(c.wick_bottom), PC_WHITE);
+					GfxFillRect(cx - ScaleGUITrad(1), oy + ScaleGUITrad(c.body_top), cx + ScaleGUITrad(1), oy + ScaleGUITrad(c.body_bottom), c.up ? PC_GREEN : PC_RED);
+				}
+				break;
+			}
+
 			case WID_S_RIGHT: {
