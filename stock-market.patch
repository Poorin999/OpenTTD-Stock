+				NWidget(WWT_PUSHTXTBTN, COLOUR_GREY, WID_SO_PLACE), SetMinimalSize(200, 18), SetFill(1, 0), SetResize(1, 0), SetStringTip(STR_STOCK_ORDER_PLACE, STR_STOCK_TIP_PLACE),
+			EndContainer(),
