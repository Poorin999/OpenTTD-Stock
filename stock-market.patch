diff --git a/src/stock_base.cpp b/src/stock_base.cpp
new file mode 100644
index 0000000..aaebeb0
--- /dev/null
+++ b/src/stock_base.cpp
@@ -0,0 +1,111 @@
+/*
+ * This file is part of OpenTTD.
+ * OpenTTD is free software; you can redistribute it and/or modify it under the terms of the GNU General Public License as published by the Free Software Foundation, version 2.
+ * OpenTTD is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
+ * See the GNU General Public License for more details. You should have received a copy of the GNU General Public License along with OpenTTD. If not, see <https://www.gnu.org/licenses/old-licenses/gpl-2.0>.
+ */
+
+/** @file stock_base.cpp Implementation of the in-game stock market. */
+
+#include "stdafx.h"
+#include "stock_base.h"
+#include "company_base.h"
+#include "company_func.h"
+#include "window_func.h"
+#include "timer/timer.h"
+#include "timer/timer_game_economy.h"
+
+#include "safeguards.h"
+
+StockMarket _stock_market;
+
+/** Forget everything, e.g. when a new game is started. */
+void StockMarket::Reset()
+{
+	for (auto &list : this->candles) list.clear();
+	this->current.fill({});
+	this->has_current.fill(false);
+	for (auto &row : this->holdings) row.fill({});
+}
+
+/**
+ * Get the current price of one share of a company.
+ * @param company The company.
+ * @return The price, or 0 when the company does not exist.
+ */
+int64_t GetStockPrice(CompanyID company)
+{
+	const Company *c = Company::GetIfValid(company);
+	if (c == nullptr) return 0;
+	int64_t value = static_cast<int64_t>(CalculateCompanyValue(c));
+	return std::max<int64_t>(1, value / STOCK_SHARES_PER_COMPANY);
+}
+
+/**
+ * A company does not exist any more: pay the owners of its shares the last price and forget the company.
+ * @param index Index of the company slot.
+ */
+void StockMarket::DelistCompany(uint8_t index)
+{
+	int64_t last_price = 0;
+	if (this->has_current[index]) {
+		last_price = this->current[index].close;
+	} else if (!this->candles[index].empty()) {
+		last_price = this->candles[index].back().close;
+	}
+
+	for (uint8_t owner = 0; owner < MAX_COMPANIES; owner++) {
+		StockHolding &holding = this->holdings[owner][index];
+		if (holding.shares > 0 && owner != index) {
+			Company *oc = Company::GetIfValid(CompanyID{owner});
+			if (oc != nullptr) {
+				oc->money += last_price * holding.shares;
+				InvalidateWindowData(WC_FINANCES, owner);
+			}
+		}
+		holding = {};
+	}
+
+	this->holdings[index].fill({});
+	this->candles[index].clear();
+	this->current[index] = {};
+	this->has_current[index] = false;
+}
+
+/** Recompute all prices; called once per day. Starts a new candle at the start of a month. */
+void StockMarket::UpdateDaily()
+{
+	const int32_t ym = TimerGameEconomy::year.base() * 12 + TimerGameEconomy::month;
+
+	for (uint8_t i = 0; i < MAX_COMPANIES; i++) {
+		CompanyID cid{i};
+		if (!Company::IsValidID(cid)) {
+			if (this->has_current[i] || !this->candles[i].empty()) this->DelistCompany(i);
+			continue;
+		}
+
+		int64_t price = GetStockPrice(cid);
+		StockCandle &cur = this->current[i];
+
+		if (!this->has_current[i]) {
+			cur = {ym, price, price, price, price};
+			this->has_current[i] = true;
+		} else if (cur.ym != ym) {
+			auto &list = this->candles[i];
+			list.push_back(cur);
+			if (list.size() > STOCK_MAX_CANDLES) list.erase(list.begin());
+			int64_t prev_close = cur.close;
+			cur = {ym, prev_close, std::max(prev_close, price), std::min(prev_close, price), price};
+		} else {
+			cur.high = std::max(cur.high, price);
+			cur.low = std::min(cur.low, price);
+			cur.close = price;
+		}
+	}
+}
+
+/** Update the market once per economy day. */
+static const IntervalTimer<TimerGameEconomy> _stock_daily({TimerGameEconomy::DAY, TimerGameEconomy::Priority::COMPANY}, [](auto)
+{
+	_stock_market.UpdateDaily();
+});
