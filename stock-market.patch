diff --git a/src/saveload/stock_sl.cpp b/src/saveload/stock_sl.cpp
new file mode 100644
index 0000000..96850b0
--- /dev/null
+++ b/src/saveload/stock_sl.cpp
@@ -0,0 +1,132 @@
+/*
+ * This file is part of OpenTTD.
+ * OpenTTD is free software; you can redistribute it and/or modify it under the terms of the GNU General Public License as published by the Free Software Foundation, version 2.
+ * OpenTTD is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
+ * See the GNU General Public License for more details. You should have received a copy of the GNU General Public License along with OpenTTD. If not, see <https://www.gnu.org/licenses/old-licenses/gpl-2.0>.
+ */
+
+/** @file stock_sl.cpp Code handling saving and loading of the stock market. */
+
+#include "../stdafx.h"
+
+#include "saveload.h"
+#include "compat/stock_sl_compat.h"
+
+#include "../stock_base.h"
+
+#include "../safeguards.h"
+
+/** One saved record of the stock market. */
+struct StockRecord {
+	uint8_t kind = 0; ///< 0 = closed candle, 1 = running candle, 2 = holding.
+	uint8_t a = 0;    ///< Company index (candles) or owner (holding).
+	uint8_t b = 0;    ///< Target company (holding).
+	int32_t ym = 0;   ///< Month of the candle.
+	int64_t v1 = 0;   ///< Candle: open. Holding: shares.
+	int64_t v2 = 0;   ///< Candle: high. Holding: invested money.
+	int64_t v3 = 0;   ///< Candle: low.
+	int64_t v4 = 0;   ///< Candle: close.
+};
+
+static const SaveLoad _stock_desc[] = {
+	SLE_VAR(StockRecord, kind, SLE_UINT8),
+	SLE_VAR(StockRecord, a,    SLE_UINT8),
+	SLE_VAR(StockRecord, b,    SLE_UINT8),
+	SLE_VAR(StockRecord, ym,   SLE_INT32),
+	SLE_VAR(StockRecord, v1,   SLE_INT64),
+	SLE_VAR(StockRecord, v2,   SLE_INT64),
+	SLE_VAR(StockRecord, v3,   SLE_INT64),
+	SLE_VAR(StockRecord, v4,   SLE_INT64),
+};
+
+struct STCKChunkHandler : ChunkHandler {
+	STCKChunkHandler() : ChunkHandler('STCK', CH_TABLE) {}
+
+	void Save() const override
+	{
+		SlTableHeader(_stock_desc);
+
+		int index = 0;
+		auto write = [&](StockRecord &record) {
+			SlSetArrayIndex(index++);
+			SlObject(&record, _stock_desc);
+		};
+
+		for (uint8_t i = 0; i < MAX_COMPANIES; i++) {
+			for (const StockCandle &candle : _stock_market.candles[i]) {
+				StockRecord record;
+				record.kind = 0;
+				record.a = i;
+				record.ym = candle.ym;
+				record.v1 = candle.open;
+				record.v2 = candle.high;
+				record.v3 = candle.low;
+				record.v4 = candle.close;
+				write(record);
+			}
+
+			if (_stock_market.has_current[i]) {
+				const StockCandle &candle = _stock_market.current[i];
+				StockRecord record;
+				record.kind = 1;
+				record.a = i;
+				record.ym = candle.ym;
+				record.v1 = candle.open;
+				record.v2 = candle.high;
+				record.v3 = candle.low;
+				record.v4 = candle.close;
+				write(record);
+			}
+
+			for (uint8_t t = 0; t < MAX_COMPANIES; t++) {
+				const StockHolding &holding = _stock_market.holdings[i][t];
+				if (holding.shares == 0) continue;
+				StockRecord record;
+				record.kind = 2;
+				record.a = i;
+				record.b = t;
+				record.v1 = holding.shares;
+				record.v2 = holding.invested;
+				write(record);
+			}
+		}
+	}
+
+	void Load() const override
+	{
+		const std::vector<SaveLoad> slt = SlCompatTableHeader(_stock_desc, _stock_sl_compat);
+
+		_stock_market.Reset();
+
+		int index;
+		while ((index = SlIterateArray()) != -1) {
+			StockRecord record;
+			SlObject(&record, slt);
+
+			if (record.a >= MAX_COMPANIES) continue;
+
+			if (record.kind == 2) {
+				if (record.b >= MAX_COMPANIES) continue;
+				StockHolding &holding = _stock_market.holdings[record.a][record.b];
+				holding.shares = record.v1;
+				holding.invested = record.v2;
+				continue;
+			}
+
+			StockCandle candle{record.ym, record.v1, record.v2, record.v3, record.v4};
+			if (record.kind == 0) {
+				_stock_market.candles[record.a].push_back(candle);
+			} else if (record.kind == 1) {
+				_stock_market.current[record.a] = candle;
+				_stock_market.has_current[record.a] = true;
+			}
+		}
+	}
+};
+
+static const STCKChunkHandler STCK;
+static const ChunkHandlerRef stock_chunk_handlers[] = {
+	STCK,
+};
+
+extern const ChunkHandlerTable _stock_chunk_handlers(stock_chunk_handlers);
