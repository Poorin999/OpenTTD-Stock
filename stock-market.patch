+
+/** @file stock_cmd.cpp Commands to buy and sell shares of companies. */
+
+#include "stdafx.h"
+#include "stock_cmd.h"
+#include "stock_base.h"
+#include "command_func.h"
+#include "company_base.h"
+#include "company_func.h"
+#include "window_func.h"
+
+#include "table/strings.h"
+
+#include "safeguards.h"
+
+/** Largest number of shares that can be traded with one command. */
+static constexpr uint32_t STOCK_MAX_TRADE = 1000000;
+
+/**
+ * Buy shares of a company. There is no limit on how many shares may be owned.
+ * @param flags Type of operation.
+ * @param target Company whose shares are bought.
+ * @param shares Number of shares to buy.
+ * @return The cost of this operation or an error.
+ */
+CommandCost CmdBuyStock(DoCommandFlags flags, CompanyID target, uint32_t shares)
+{
+	if (!Company::IsValidID(_current_company)) return CMD_ERROR;
+	if (!Company::IsValidID(target) || shares == 0 || shares > STOCK_MAX_TRADE) return CMD_ERROR;
+
+	int64_t price = GetStockPrice(target);
+	int64_t total = price * static_cast<int64_t>(shares);
+
+	if (flags.Test(DoCommandFlag::Execute)) {
+		StockHolding &holding = _stock_market.holdings[_current_company.base()][target.base()];
+		holding.shares += shares;
+		holding.invested += total;
+		InvalidateWindowData(WC_STOCK_MARKET, 0);
+	}
+
+	return CommandCost(EXPENSES_OTHER, Money(total));
+}
+
+/**
+ * Sell shares of a company.
+ * @param flags Type of operation.
+ * @param target Company whose shares are sold.
+ * @param shares Number of shares to sell.
+ * @return The (negative) cost of this operation or an error.
+ */
+CommandCost CmdSellStock(DoCommandFlags flags, CompanyID target, uint32_t shares)
+{
+	if (!Company::IsValidID(_current_company)) return CMD_ERROR;
+	if (!Company::IsValidID(target) || shares == 0 || shares > STOCK_MAX_TRADE) return CMD_ERROR;
+
+	StockHolding &holding = _stock_market.holdings[_current_company.base()][target.base()];
+	if (holding.shares < static_cast<int64_t>(shares)) return CommandCost(STR_STOCK_ERROR_NOT_ENOUGH_SHARES);
+
+	int64_t price = GetStockPrice(target);
+	int64_t proceeds = price * static_cast<int64_t>(shares);
+
+	if (flags.Test(DoCommandFlag::Execute)) {
+		int64_t average = holding.invested / holding.shares;
+		holding.invested -= average * static_cast<int64_t>(shares);
+		holding.shares -= shares;
+		if (holding.shares == 0) holding.invested = 0;
+		InvalidateWindowData(WC_STOCK_MARKET, 0);
+	}
+
+	return CommandCost(EXPENSES_OTHER, -Money(proceeds));
+}
