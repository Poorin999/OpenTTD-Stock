+ * OpenTTD is free software; you can redistribute it and/or modify it under the terms of the GNU General Public License as published by the Free Software Foundation, version 2.
+ * OpenTTD is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
+ * See the GNU General Public License for more details. You should have received a copy of the GNU General Public License along with OpenTTD. If not, see <https://www.gnu.org/licenses/old-licenses/gpl-2.0>.
+ */
+
+/** @file stock_base.h Data of the in-game stock market: share prices, monthly candles and holdings. */
+
+#ifndef STOCK_BASE_H
+#define STOCK_BASE_H
+
+#include "company_type.h"
+#include <array>
+#include <vector>
+
+/** Number of (virtual) shares every company has. The share price is the company value divided by this. */
+static constexpr int64_t STOCK_SHARES_PER_COMPANY = 1000;
+
+/** Maximum number of closed monthly candles that are remembered per company. */
+static constexpr size_t STOCK_MAX_CANDLES = 240;
+
+/** One candle of the stock chart; covers one economy month. */
+struct StockCandle {
+	int32_t ym = 0;      ///< Economy year * 12 + month.
+	int64_t open = 0;    ///< Share price at the start of the month.
+	int64_t high = 0;    ///< Highest share price of the month.
+	int64_t low = 0;     ///< Lowest share price of the month.
+	int64_t close = 0;   ///< Share price at the end of the month (or the latest price for the running month).
+};
+
+/** Shares of one company that are owned by another company. */
+struct StockHolding {
+	int64_t shares = 0;   ///< Number of shares owned.
+	int64_t invested = 0; ///< Total money paid for the shares that are still owned.
+};
+
+/** All state of the stock market. Saved in the 'STCK' chunk. */
+struct StockMarket {
+	std::array<std::vector<StockCandle>, MAX_COMPANIES> candles{}; ///< Closed candles per company.
+	std::array<StockCandle, MAX_COMPANIES> current{};              ///< The running candle per company.
+	std::array<bool, MAX_COMPANIES> has_current{};                 ///< Whether #current is valid.
+	std::array<std::array<StockHolding, MAX_COMPANIES>, MAX_COMPANIES> holdings{}; ///< Shares by [owner][target].
+
+	void Reset();
+	void UpdateDaily();
+
+private:
+	void DelistCompany(uint8_t index);
+};
+
+extern StockMarket _stock_market;
+
+int64_t GetStockPrice(CompanyID company);
+
+#endif /* STOCK_BASE_H */
