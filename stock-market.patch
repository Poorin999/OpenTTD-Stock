+ */
+
+/** @file stock_gui.cpp The stock market window with a monthly candlestick chart and buy/sell buttons. */
+
+#include "stdafx.h"
+#include "stock_gui.h"
+#include "stock_base.h"
+#include "stock_cmd.h"
+#include "command_func.h"
+#include "company_base.h"
+#include "company_func.h"
+#include "gfx_func.h"
+#include "palette_func.h"
+#include "strings_func.h"
+#include "window_func.h"
+#include "window_gui.h"
+#include "zoom_func.h"
+#include "timer/timer.h"
+#include "timer/timer_game_economy.h"
+
+#include "widgets/stock_widget.h"
+
+#include "table/strings.h"
+
+#include "safeguards.h"
+
+struct StockWindow : Window {
+	CompanyID selected = INVALID_OWNER; ///< Company whose chart is shown.
+
+	StockWindow(WindowDesc &desc) : Window(desc)
+	{
+		this->CreateNestedTree();
+		this->FinishInitNested(0);
+		this->EnsureValidSelection();
+	}
+
+	/** Make sure #selected is a company that exists. */
+	void EnsureValidSelection()
+	{
+		if (Company::IsValidID(this->selected)) return;
+		if (Company::IsValidID(_local_company)) {
+			this->selected = _local_company;
+			return;
+		}
+		for (const Company *c : Company::Iterate()) {
+			this->selected = c->index;
+			return;
+		}
+		this->selected = INVALID_OWNER;
+	}
+
+	/**
+	 * Select the next or previous existing company.
+	 * @param forward Select the next one when true, the previous one when false.
+	 */
+	void CycleCompany(bool forward)
+	{
+		std::vector<CompanyID> ids;
+		for (const Company *c : Company::Iterate()) ids.push_back(c->index);
+		if (ids.empty()) return;
+
+		size_t pos = 0;
+		for (size_t i = 0; i < ids.size(); i++) {
+			if (ids[i] == this->selected) pos = i;
+		}
+		pos = (pos + (forward ? 1 : ids.size() - 1)) % ids.size();
+		this->selected = ids[pos];
+		this->SetDirty();
+	}
+
+	void Trade(bool buy, uint32_t shares)
+	{
+		if (!Company::IsValidID(_local_company) || !Company::IsValidID(this->selected)) return;
+		if (buy) {
+			Command<CMD_BUY_STOCK>::Post(STR_STOCK_ERROR_CANT_BUY, this->selected, shares);
+		} else {
+			Command<CMD_SELL_STOCK>::Post(STR_STOCK_ERROR_CANT_SELL, this->selected, shares);
+		}
+	}
+
+	void OnPaint() override
+	{
+		this->EnsureValidSelection();
+		this->DrawWidgets();
+	}
+
+	void OnClick([[maybe_unused]] Point pt, WidgetID widget, [[maybe_unused]] int click_count) override
+	{
+		switch (widget) {
+			case WID_ST_PREV:     this->CycleCompany(false); break;
+			case WID_ST_NEXT:     this->CycleCompany(true); break;
+			case WID_ST_BUY_1:    this->Trade(true, 1); break;
+			case WID_ST_BUY_10:   this->Trade(true, 10); break;
+			case WID_ST_BUY_100:  this->Trade(true, 100); break;
+			case WID_ST_SELL_1:   this->Trade(false, 1); break;
+			case WID_ST_SELL_10:  this->Trade(false, 10); break;
+			case WID_ST_SELL_100: this->Trade(false, 100); break;
+			default: break;
+		}
+	}
+
+	void OnInvalidateData([[maybe_unused]] int data = 0, [[maybe_unused]] bool gui_scope = true) override
+	{
+		if (gui_scope) this->SetDirty();
+	}
+
+	void DrawWidget(const Rect &r, WidgetID widget) const override
+	{
+		if (!Company::IsValidID(this->selected)) return;
+
+		switch (widget) {
+			case WID_ST_TITLE: this->DrawTitle(r); break;
+			case WID_ST_CHART: this->DrawChart(r); break;
+			case WID_ST_INFO:  this->DrawInfo(r); break;
+			default: break;
+		}
+	}
+
+	/** The price one month ago, used to show the change. */
+	int64_t GetReferencePrice() const
+	{
+		const size_t index = this->selected.base();
+		if (!_stock_market.candles[index].empty()) return _stock_market.candles[index].back().close;
+		if (_stock_market.has_current[index]) return _stock_market.current[index].open;
+		return GetStockPrice(this->selected);
+	}
+
+	void DrawTitle(const Rect &r) const
+	{
+		const int top = CentreBounds(r.top, r.bottom, GetCharacterHeight(FS_NORMAL));
+		const int64_t price = GetStockPrice(this->selected);
+		DrawString(r.left + 4, r.right - 4, top, GetString(STR_STOCK_TITLE, this->selected, price), TC_FROMSTRING, SA_LEFT);
+
+		const int64_t reference = this->GetReferencePrice();
+		const int64_t tenths = reference > 0 ? (price - reference) * 1000 / reference : 0;
+		const int64_t abs_tenths = tenths < 0 ? -tenths : tenths;
+		StringID str = tenths >= 0 ? STR_STOCK_CHANGE_UP : STR_STOCK_CHANGE_DOWN;
+		DrawString(r.left + 4, r.right - 4, top, GetString(str, abs_tenths / 10, abs_tenths % 10), TC_FROMSTRING, SA_RIGHT);
+	}
+
+	void DrawChart(const Rect &r) const
+	{
+		const size_t index = this->selected.base();
+
+		std::vector<StockCandle> candles = _stock_market.candles[index];
+		if (_stock_market.has_current[index]) candles.push_back(_stock_market.current[index]);
+
+		const int small_height = GetCharacterHeight(FS_SMALL);
+		const int axis_width = ScaleGUITrad(64);
+		const int left = r.left + axis_width;
+		const int right = r.right - ScaleGUITrad(6);
+		const int top = r.top + ScaleGUITrad(6);
+		const int bottom = r.bottom - small_height - ScaleGUITrad(4);
+		if (right - left < 20 || bottom - top < 20) return;
+
+		GfxFillRect(left, top, right, bottom, GREY_SCALE(2));
+
+		if (candles.empty()) return;
+
+		const int slot = ScaleGUITrad(10);
+		const int body_half = ScaleGUITrad(3);
+		const size_t max_visible = static_cast<size_t>((right - left) / slot);
+		const size_t first = candles.size() > max_visible ? candles.size() - max_visible : 0;
+
+		int64_t lo = INT64_MAX;
+		int64_t hi = INT64_MIN;
+		for (size_t i = first; i < candles.size(); i++) {
+			lo = std::min(lo, candles[i].low);
+			hi = std::max(hi, candles[i].high);
+		}
+		int64_t margin = std::max<int64_t>((hi - lo) / 10, 1);
+		lo = std::max<int64_t>(lo - margin, 0);
+		hi += margin;
+		const double range = static_cast<double>(hi - lo);
+
+		auto to_y = [&](int64_t value) {
+			return bottom - static_cast<int>(static_cast<double>(value - lo) * (bottom - top) / range);
+		};
+
+		/* Horizontal grid lines with price labels. */
+		for (int i = 0; i <= 4; i++) {
+			int64_t value = lo + (hi - lo) * i / 4;
+			int y = to_y(value);
+			GfxDrawLine(left, y, right, y, GREY_SCALE(4));
+			DrawString(r.left + 2, left - 4, y - small_height / 2, GetString(STR_JUST_CURRENCY_SHORT, value), TC_WHITE, SA_RIGHT, false, FS_SMALL);
+		}
+
+		/* Candles, the newest at the right edge. */
+		const int count = static_cast<int>(candles.size() - first);
+		const int x0 = right - count * slot;
+		for (int i = 0; i < count; i++) {
+			const StockCandle &c = candles[first + i];
+			const int cx = x0 + i * slot + slot / 2;
+			const bool up = c.close >= c.open;
+			const PixelColour colour = up ? PC_GREEN : PC_RED;
+
+			GfxDrawLine(cx, to_y(c.high), cx, to_y(c.low), PC_WHITE);
+
+			int body_top = to_y(std::max(c.open, c.close));
+			int body_bottom = to_y(std::min(c.open, c.close));
+			if (body_bottom <= body_top) body_bottom = body_top + 1;
+			GfxFillRect(cx - body_half, body_top, cx + body_half, body_bottom, colour);
+
+			if (c.ym % 12 == 0) {
+				GfxDrawLine(cx, bottom, cx, bottom + ScaleGUITrad(3), PC_WHITE);
+				DrawString(cx - ScaleGUITrad(20), cx + ScaleGUITrad(20), bottom + ScaleGUITrad(3), GetString(STR_JUST_INT, c.ym / 12), TC_WHITE, SA_HOR_CENTER, false, FS_SMALL);
+			}
+		}
+	}
+
+	void DrawInfo(const Rect &r) const
+	{
+		const int line = GetCharacterHeight(FS_NORMAL) + ScaleGUITrad(2);
+		int y = r.top + ScaleGUITrad(3);
+		const int left = r.left + 4;
+		const int right = r.right - 4;
+
+		if (!Company::IsValidID(_local_company)) {
+			DrawString(left, right, y, STR_STOCK_SPECTATOR, TC_FROMSTRING, SA_LEFT);
+			return;
+		}
+
+		const StockHolding &holding = _stock_market.holdings[_local_company.base()][this->selected.base()];
+		const int64_t price = GetStockPrice(this->selected);
+		const int64_t value = holding.shares * price;
+		const int64_t average = holding.shares > 0 ? holding.invested / holding.shares : 0;
+
+		DrawString(left, right, y, GetString(STR_STOCK_INFO_OWNED, holding.shares, value), TC_FROMSTRING, SA_LEFT);
+		y += line;
+		DrawString(left, right, y, GetString(STR_STOCK_INFO_COST, average, value - holding.invested), TC_FROMSTRING, SA_LEFT);
+		y += line;
+		const Company *own = Company::Get(_local_company);
+		DrawString(left, right, y, GetString(STR_STOCK_INFO_CASH, static_cast<int64_t>(own->money)), TC_FROMSTRING, SA_LEFT);
+	}
+
+	/** Redraw every day, the prices change daily. */
+	const IntervalTimer<TimerGameEconomy> daily_interval = {{TimerGameEconomy::DAY, TimerGameEconomy::Priority::NONE}, [this](auto) {
+		this->SetDirty();
+	}};
+};
+
+static constexpr std::initializer_list<NWidgetPart> _nested_stock_widgets = {
+	NWidget(NWID_HORIZONTAL),
+		NWidget(WWT_CLOSEBOX, COLOUR_GREY),
+		NWidget(WWT_CAPTION, COLOUR_GREY), SetStringTip(STR_STOCK_CAPTION),
+		NWidget(WWT_SHADEBOX, COLOUR_GREY),
+		NWidget(WWT_DEFSIZEBOX, COLOUR_GREY),
+		NWidget(WWT_STICKYBOX, COLOUR_GREY),
+	EndContainer(),
+	NWidget(NWID_HORIZONTAL),
+		NWidget(WWT_PUSHTXTBTN, COLOUR_GREY, WID_ST_PREV), SetMinimalSize(24, 14), SetStringTip(STR_STOCK_PREV, STR_STOCK_TIP_PREV),
+		NWidget(WWT_PANEL, COLOUR_GREY, WID_ST_TITLE), SetMinimalSize(300, 14), SetResize(1, 0), SetFill(1, 0),
+		EndContainer(),
+		NWidget(WWT_PUSHTXTBTN, COLOUR_GREY, WID_ST_NEXT), SetMinimalSize(24, 14), SetStringTip(STR_STOCK_NEXT, STR_STOCK_TIP_NEXT),
+	EndContainer(),
+	NWidget(WWT_PANEL, COLOUR_GREY, WID_ST_CHART), SetMinimalSize(348, 200), SetResize(1, 1), SetFill(1, 1),
+	EndContainer(),
+	NWidget(WWT_PANEL, COLOUR_GREY, WID_ST_INFO), SetMinimalSize(348, 50), SetResize(1, 0), SetFill(1, 0),
+	EndContainer(),
+	NWidget(NWID_HORIZONTAL, NWidContainerFlag::EqualSize),
+		NWidget(WWT_PUSHTXTBTN, COLOUR_GREEN, WID_ST_BUY_1), SetFill(1, 0), SetResize(1, 0), SetStringTip(STR_STOCK_BUY_1, STR_STOCK_TIP_BUY),
+		NWidget(WWT_PUSHTXTBTN, COLOUR_GREEN, WID_ST_BUY_10), SetFill(1, 0), SetResize(1, 0), SetStringTip(STR_STOCK_BUY_10, STR_STOCK_TIP_BUY),
+		NWidget(WWT_PUSHTXTBTN, COLOUR_GREEN, WID_ST_BUY_100), SetFill(1, 0), SetResize(1, 0), SetStringTip(STR_STOCK_BUY_100, STR_STOCK_TIP_BUY),
+		NWidget(WWT_PUSHTXTBTN, COLOUR_RED, WID_ST_SELL_1), SetFill(1, 0), SetResize(1, 0), SetStringTip(STR_STOCK_SELL_1, STR_STOCK_TIP_SELL),
+		NWidget(WWT_PUSHTXTBTN, COLOUR_RED, WID_ST_SELL_10), SetFill(1, 0), SetResize(1, 0), SetStringTip(STR_STOCK_SELL_10, STR_STOCK_TIP_SELL),
+		NWidget(WWT_PUSHTXTBTN, COLOUR_RED, WID_ST_SELL_100), SetFill(1, 0), SetResize(1, 0), SetStringTip(STR_STOCK_SELL_100, STR_STOCK_TIP_SELL),
+	EndContainer(),
+	NWidget(NWID_HORIZONTAL),
+		NWidget(WWT_PANEL, COLOUR_GREY), SetFill(1, 0), SetResize(1, 0),
+		EndContainer(),
+		NWidget(WWT_RESIZEBOX, COLOUR_GREY),
+	EndContainer(),
+};
+
+static WindowDesc _stock_desc(
+	WDP_AUTO, "stock_market", 380, 320,
+	WC_STOCK_MARKET, WC_NONE,
+	{},
+	_nested_stock_widgets
+);
+
+/** Open the stock market window, or bring it to the front when it is already open. */
+void ShowStockWindow()
+{
+	if (BringWindowToFrontById(WC_STOCK_MARKET, 0) != nullptr) return;
+	new StockWindow(_stock_desc);
+}
